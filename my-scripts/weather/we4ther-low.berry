# @name we4ther-low
# @desc Today's low temperature, color gradient. Reads we4ther-temp's fetch
# @author github: jeremyeder
# @version 1.0
# @requires we4therlib
# @requires we4ther-temp

import we4therlib

class We4therLow
  var low

  def init()
    self.low = nil
  end

  def loop()
    var age = shared.age("we4ther-temp.low")
    self.low = (age == nil || age > 3600000) ? nil : shared.get("we4ther-temp.low")
  end

  def draw()
    clear()
    if self.low == nil
      text(6, 6, "...", 0x666666)
      return
    end
    var parts = we4therlib.screen("Low", self.low)
    var w = text_ink_width(parts)
    text(int((width() - w) / 2), 6, parts)
  end
end

return We4therLow()
