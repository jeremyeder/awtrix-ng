# @module sc0relib
# @desc Shared ESPN fetch/parse/format helpers for the team score apps
# @config everyLive number "Refresh while live"     default=60  min=15  max=300  unit=s
# @config everyIdle number "Refresh otherwise"      default=300 min=60  max=3600 unit=s
# @config onlyToday bool   "Only show if playing today" default=true

import string

var m = module("sc0relib")

m.every_live = store.get("everyLive")
m.every_idle = store.get("everyIdle")
m.only_today = store.get("onlyToday")

m.paths = {
  "mlb": "baseball/mlb",
  "nba": "basketball/nba",
  "nhl": "hockey/nhl",
  "nfl": "football/nfl",
}

# Team-scoped endpoint: stays small regardless of the day's full schedule.
m.url = def (sport, abbr)
  return "https://site.api.espn.com/apis/site/v2/sports/" + m.paths[sport] +
         "/teams/" + string.tolower(abbr)
end

# One keep spanning both competitors+status was unreliable above ~10KB on
# device (keep=12000 nil'd the body, keep=10000 didn't) and kept growing
# per-team anyway (each competitor's "team" object has a links/logos array
# before whatever's next). So: 3 small, independently-anchored fetches.
m.CAP = 24000
m.ANCHOR_LEAD = {"find": "\"nextEvent\":[{", "keep": 800, "cap": m.CAP}
m.ANCHOR_COMP2 = {"find": "},{\"homeAway\"", "keep": 200, "cap": m.CAP}
# Competitors close straight into date,id,neutralSite,notes,status; anchor
# here (not "status":{"clock) since far-future TBD games lack a clock key.
m.ANCHOR_STATUS = {"find": "}],\"date\":\"", "keep": 550, "cap": m.CAP}

# {abbr, score} for one competitor chunk. ESPN omits "score" until the game
# starts, so it's nil pre-game.
m.parse_competitor = def (chunk)
  var a = re.search("\"abbreviation\":\"([A-Za-z]+)\"", chunk)
  if a == nil return nil end
  var pos = string.find(chunk, a[0])
  var s = re.search("\"score\":{\"displayValue\":\"([^\"]*)\"", chunk[0..pos - 1])
  return {"abbr": a[1], "score": s != nil ? s[1] : nil}
end

m.parse_lead = def (chunk)
  var net = re.search("\"shortName\":\"([^\"]+)\"", chunk)
  var comp = m.parse_competitor(chunk)
  if comp == nil return nil end
  return {"network": net != nil ? net[1] : nil, "comp": comp}
end

m.parse_status = def (chunk)
  var info = {}
  var st = re.search("\"state\":\"([a-z]+)\"", chunk)
  info["state"] = st != nil ? st[1] : "pre"
  var per = re.search("\"period\":([0-9]+)", chunk)
  info["period"] = per != nil ? int(per[1]) : 0
  var clk = re.search("\"displayClock\":\"([^\"]*)\"", chunk)
  info["clock"] = clk != nil ? clk[1] : "0:00"
  var det = re.search("\"detail\":\"([^\"]*)\"", chunk)
  info["detail"] = det != nil ? det[1] : ""
  var sdet = re.search("\"shortDetail\":\"([^\"]*)\"", chunk)
  info["short_detail"] = sdet != nil ? sdet[1] : info["detail"]
  info["is_today"] = m.event_is_today(chunk, info["short_detail"])
  # Parsed ourselves, not trusted to ESPN's shortDetail: a far-future game
  # with no confirmed time answers "TBD" with no date at all, which reads
  # as today's game when onlyToday is off. "date" is in every chunk
  # (ANCHOR_STATUS is anchored right at it).
  var dt = re.search("\"date\":\"[0-9]+-([0-9]+)-([0-9]+)T", chunk)
  info["event_date"] = dt != nil ? str(int(dt[1])) + "/" + str(int(dt[2])) : nil
  return info
end

# Julian day number: compares calendar days across month/year rollover.
m.jdn = def (y, mo, d)
  var a = int((14 - mo) / 12)
  var y2 = y + 4800 - a
  var m2 = mo + 12 * a - 3
  return d + int((153 * m2 + 2) / 5) + 365 * y2 + int(y2 / 4) - int(y2 / 100) +
         int(y2 / 400) - 32045
end

# ESPN's detail text names its own zone, no need for the device's UTC
# offset. Defaults to EDT when absent (only matters for far-future games).
m.ZONE_OFFSETS = {
  "EDT": -4, "EST": -5, "CDT": -5, "CST": -6,
  "MDT": -6, "MST": -7, "PDT": -7, "PST": -8,
}
m.zone_offset = def (text)
  var zm = re.search("(EDT|EST|CDT|CST|MDT|MST|PDT|PST)", text)
  if zm == nil return -4 end
  var off = m.ZONE_OFFSETS[zm[1]]
  return off != nil ? off : -4
end

m.event_is_today = def (chunk, zone_text)
  var dt = re.search("\"date\":\"([0-9]+)-([0-9]+)-([0-9]+)T([0-9]+):", chunk)
  if dt == nil return false end
  var jdn = m.jdn(int(dt[1]), int(dt[2]), int(dt[3]))
  var h = int(dt[4]) + m.zone_offset(zone_text)
  if h < 0 jdn -= 1 elif h >= 24 jdn += 1 end
  return jdn == m.jdn(year(), month(), day())
end

m.combine = def (lead, comp2, status, my_abbr)
  if lead == nil || comp2 == nil || status == nil return nil end
  var comp1 = lead["comp"]
  var mine, theirs, opp_abbr
  if comp1["abbr"] == my_abbr
    mine = comp1["score"] theirs = comp2["score"] opp_abbr = comp2["abbr"]
  else
    mine = comp2["score"] theirs = comp1["score"] opp_abbr = comp1["abbr"]
  end
  return {
    "network": lead["network"], "my_score": mine,
    "opp_abbr": opp_abbr, "opp_score": theirs,
    "state": status["state"], "period": status["period"],
    "clock": status["clock"], "detail": status["detail"],
    "short_detail": status["short_detail"], "is_today": status["is_today"],
    "event_date": status["event_date"],
  }
end

# Compact period/clock label for a live game; pre/post games use ESPN's own
# short_detail ("10/18 - 1:00 PM EDT", "Final", "Final/OT", ...).
m.period_label = def (sport, info)
  if info["state"] != "in" return info["short_detail"] end
  var p = info["period"]
  var clock = info["clock"]
  if sport == "mlb"
    var half = re.search("(Top|Bot|Mid|End) ([0-9]+)", info["detail"])
    if half == nil return info["short_detail"] end
    var letter = "?"
    if half[1] == "Top" letter = "T"
    elif half[1] == "Bot" letter = "B"
    elif half[1] == "Mid" letter = "M"
    elif half[1] == "End" letter = "E"
    end
    return letter + half[2]
  elif sport == "nhl"
    if p <= 3 return "P" + str(p) + " " + clock
    elif p == 4 return "OT " + clock
    else return "SO" end
  else # nfl, nba
    if p <= 4 return "Q" + str(p) + " " + clock
    else return "OT " + clock end
  end
end

# Score color: green ahead, red behind, yellow tied, white if no score yet.
m.color = def (mine, theirs)
  var a = num(mine)
  var b = num(theirs)
  if a == nil || b == nil return 0xFFFFFF end
  if a > b return 0x00CC44 end
  if a < b return 0xCC2222 end
  return 0xCCCC00
end

# Shared app behavior. Each team's @script is just
# `return sc0relib.make("<ABBR>", "<sport>")`.
class _TeamApp
  var abbr, sport, ticks, busy, info, lead, comp2

  def init(abbr, sport)
    self.abbr = abbr
    self.sport = sport
    self.ticks = 0
    self.busy = false
    self.info = store.get("info")
  end

  def fetch_lead()
    http.get(m.url(self.sport, self.abbr), / b, st -> self.on_lead(b, st), m.ANCHOR_LEAD)
  end

  def on_lead(b, st)
    if b == nil self.busy = false return end
    self.lead = m.parse_lead(b)
    if self.lead == nil self.busy = false return end
    http.get(m.url(self.sport, self.abbr), / b2, st2 -> self.on_comp2(b2, st2), m.ANCHOR_COMP2)
  end

  def on_comp2(b, st)
    if b == nil self.busy = false return end
    self.comp2 = m.parse_competitor(b)
    if self.comp2 == nil self.busy = false return end
    http.get(m.url(self.sport, self.abbr), / b2, st2 -> self.on_status(b2, st2), m.ANCHOR_STATUS)
  end

  def on_status(b, st)
    self.busy = false
    if b == nil return end
    var i = m.combine(self.lead, self.comp2, m.parse_status(b), self.abbr)
    if i == nil return end
    self.info = i
    store.set("info", i)
  end

  def loop()
    if self.ticks <= 0 && !self.busy
      self.ticks = self.info != nil && self.info["state"] == "in" ? m.every_live : m.every_idle
      self.busy = true
      self.fetch_lead()
    end
    self.ticks -= 1
  end

  # Only show a team that's live, just finished, or playing today - not
  # whatever game ESPN's "next scheduled" happens to point at (which, in
  # the offseason, can be months out) - unless onlyToday is switched off.
  # Show the loading dots rather than hiding outright while data isn't in yet.
  def should_show()
    if self.info == nil return true end
    if !m.only_today return true end
    var state = self.info["state"]
    return state == "in" || state == "post" || self.info.find("is_today", true)
  end

  def draw()
    clear()
    if self.info == nil
      text(6, 6, "...", 0x666666)
      return
    end

    var parts = [[self.abbr + " ", 0x888888]]
    if self.info["state"] == "pre"
      parts.push(["vs " + self.info["opp_abbr"] + "  ", 0xFFFFFF])
      # Only onlyToday=false can ever surface a future game here, and
      # ESPN's own short_detail isn't reliable for one: a confirmed date
      # shows "10/20 - 7:00 PM EDT", but a far-future unscheduled game is
      # just "TBD" with no date at all - indistinguishable from today's
      # game without this.
      if !self.info["is_today"] && self.info["event_date"] != nil
        parts.push([self.info["event_date"] + " ", 0xFFAA00])
      end
      parts.push([self.info["short_detail"], 0xAAAAAA])
      if self.info["network"] != nil
        parts.push(["  " + self.info["network"], 0x4488FF])
      end
    else
      var mine = self.info["my_score"] != nil ? self.info["my_score"] : "-"
      var theirs = self.info["opp_score"] != nil ? self.info["opp_score"] : "-"
      parts.push([mine + "-" + theirs, m.color(self.info["my_score"], self.info["opp_score"])])
      parts.push([" " + self.info["opp_abbr"] + "  ", 0x888888])
      parts.push([m.period_label(self.sport, self.info), 0xFFFFFF])
    end
    scroll_text(parts, 0xFFFFFF)
  end
end

m.make = def (abbr, sport)
  return _TeamApp(abbr, sport)
end

return m
